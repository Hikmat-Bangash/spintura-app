{{ 'style.css' | asset_url | stylesheet_tag }}

<div class="hierarchical-carousel-wrapper" id="hierarchical-carousel">
  <div class="breadcrumb-nav" id="breadcrumb-nav">
    <span class="breadcrumb-item active" data-level="1">Top Layer</span>
  </div>
<div class="carousel-level level-1" id="level-1-carousel">
  <div class="carousel-items" id="level-1-items"></div>
</div>
<div class="carousel-level level-2" id="level-2-carousel" style="display: none;">
  <div class="carousel-items" id="level-2-items"></div>
</div>
<div class="carousel-level level-3" id="level-3-carousel" style="display: none;">
  <div class="carousel-items" id="level-3-items"></div>
</div>
</div>
<div class="wrapper w-full h-full flex flex-col gap-9 justify-center items-center" id="spinning-tool-wrapper" style="position: relative;"> <div
class="carousel-container"
id="spinning-tool-carousel"
style="position: relative; width: 400px; height: 400px; perspective: 1000px;">
<div
  class="carousel carousel-vertical"
  style="width: 100%; height: 100%; position: absolute; transform-style: preserve-3d; transition: transform 1s cubic-bezier(0.4, 0, 0.2, 1); z-index: 1;">
</div>
<div
  class="carousel carousel-horizontal"
  style="width: 100%; height: 100%; position: absolute; transform-style: preserve-3d; transition: transform 1s cubic-bezier(0.4, 0, 0.2, 1); z-index: 2;">
</div>
</div>

<div id="product-overlay" class="product-overlay" style="display: none;">
<div class="overlay-content">
  <button class="close-overlay" id="close-overlay">✕</button>
  <div class="product-info">
    <h3 id="overlay-product-title">Product Title</h3>
    <div class="add-to-cart-section">
      <button class="add-to-cart-btn" id="add-to-cart-btn">
        <span class="cart-icon">🛒</span>
        Add to Cart
      </button>
    </div>
  </div>
</div>
</div>

<!-- Video Modal -->
<div id="video-modal" class="video-modal">
  <div class="video-modal-content">
    <button class="video-modal-close" id="video-modal-close">✕</button>
    <video id="modal-video" controls>
      <source src="" type="video/mp4">
      Your browser does not support the video tag.
    </video>
  </div>
</div>
</div>

{% schema %}
{
"name": "spinning tool",
"target": "section",
"settings": []
}
{% endschema %}

<script src="{{ 'api-tracking-service.js' | asset_url }}" defer></script>
<script src="{{ 'spinswipe.js' | asset_url }}" defer></script>